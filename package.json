{
  "name": "web-cabanillas-dental",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js && node scripts/copy-public-assets.mjs",
    "preview": "vite preview --config vite.config.js",
    "check:build": "node scripts/verify-build.mjs",
    "worker:dev": "npm run build && wrangler dev"
  },
  "dependencies": {
    "framer-motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swiper": "14.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.4.0",
    "wrangler": "4.168.0"
  }
}
